# ── SFTP credentials ──────────────────────────────────────────────────────────
# Provided by the inventory feed vendor
SFTP_HOST=sftp.example.com
SFTP_PORT=22
SFTP_USER=your-sftp-username
SFTP_PASSWORD=your-sftp-password
# A CSV file, a folder (every .csv inside is imported), or several of either
# separated by commas — e.g. /inventory or /inventory/AudiCapeFear.csv,/inventory/LandRoverCapeFear.csv
SFTP_REMOTE_PATH=/inventory

# ── Supabase (service-role key — server-side only, never expose to browsers) ──
# Found at: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
