# ── SFTP credentials ──────────────────────────────────────────────────────────
# Provided by the inventory feed vendor
SFTP_HOST=sftp.example.com
SFTP_PORT=22
SFTP_USER=your-sftp-username
SFTP_PASSWORD=your-sftp-password
SFTP_REMOTE_PATH=/inventory/feed.csv

# ── Supabase (service-role key — server-side only, never expose to browsers) ──
# Found at: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
